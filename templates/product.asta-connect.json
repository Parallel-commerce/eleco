    "parallel_two_column_accordion_xi4PpU": {
      "type": "parallel-two-column-accordion",
      "blocks": {
        "accordion_item_AX7zXQ": {
          "type": "accordion_item",
          "settings": {
            "title": "Contractors",
            "content_1": "<p>Share clear, current programmes with internal teams and supply chain partners.</p>",
            "content_2": "<p>Align short-term lookaheads and package plans with the master schedule.</p>",
            "content_3": "<p>Track progress against baselines and maintain robust records to support claims and dispute resolution.</p>",
            "content_4": "",
            "content_5": "",
            "content_6": ""
          }
        },
        "accordion_item_htnMQm": {
          "type": "accordion_item",
          "settings": {
            "title": "Subcontractors",
            "content_1": "<p>Straightforward access to trade-specific work packages.</p>",
            "content_2": "<p>Visibility of tasks, dependencies and constraints in context.<br/></p>",
            "content_3": "<p>Update progress, resequence activities when access or design changes, and provide reliable data on labour, plant and productivity that flows back into the main programme.</p>",
            "content_4": "",
            "content_5": "",
            "content_6": ""
          }
        },
        "accordion_item_EDULcY": {
          "type": "accordion_item",
          "settings": {
            "title": "Designers and Consultants",
            "content_1": "<p>Separate design, approval and procurement programmes.</p>",
            "content_2": "<p>Assign packages to sub contractors but maintain control of the master schedule.</p>",
            "content_3": "<p>Ensure client visibility of simplified deliverables and progress.</p>",
            "content_4": "",
            "content_5": "",
            "content_6": ""
          }
        },
        "accordion_item_BxXeBx": {
          "type": "accordion_item",
          "settings": {
            "title": "Residential Construction",
            "content_1": "<p>Keep short-term lookaheads aligned with the master schedule.</p>",
            "content_2": "<p>Manage sub-contractors and trades but maintain control centrally of the programme.</p>",
            "content_3": "<p>Track starts, completions and handovers by plot, block and tenure, with structured updates feeding into central reporting.</p>",
            "content_4": "",
            "content_5": "",
            "content_6": ""
          }
        },
        "accordion_item_LTfMGp": {
