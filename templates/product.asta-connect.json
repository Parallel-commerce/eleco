    "parallel_faq_accordion_3Vq7Fm": {
      "type": "parallel-faq-accordion",
      "blocks": {
        "faq_item_QVNkTB": {
          "type": "faq_item",
          "settings": {
            "question": "What is Asta Connect?",
            "answer": "<p>Asta Connect is a fully hosted, web-based collaborative task management tool that connects project teams to the master plan and supports lean, pull planning workflows.</p>"
          }
        },
        "faq_item_bVkqMa": {
          "type": "faq_item",
          "settings": {
            "question": "Who is Asta Connect for?",
            "answer": "<p>It is designed for contractors, subcontractors, residential contractors who need to plan together, manage commitments and stay aligned with the schedule in real time.</p>"
          }
        },
        "faq_item_4Eehmt": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need to install any software?",
            "answer": "<p>No local installation is required; Asta Connect is delivered as a fully hosted, web-based application.</p>"
          }
        },
        "faq_item_jARANR": {
          "type": "faq_item",
          "settings": {
            "question": "How does Asta Connect relate to Asta Powerproject?",
            "answer": "<p>Asta Connect complements Asta Powerproject by importing master programmes so teams can plan phases, manage tasks and capture commitments while staying aligned with overall project objectives.</p>"
          }
        },
        "faq_item_y4R9qr": {
          "type": "faq_item",
          "settings": {
            "question": "How does Asta Connect improve collaboration between main contractors and subcontractors?",
            "answer": "<p>It provides a shared, web-based workspace where both parties can plan phases together, agree handoffs and keep everyone connected to the same schedule, wherever they are.<br/><br/></p>"
          }
        },
        "faq_item_maB93q": {
          "type": "faq_item",
          "settings": {
            "question": "How does Asta Connect support pull planning / Last Planner®?",
            "answer": "<p>It lets teams break work into phases, use digital whiteboards and cards to plan tasks collaboratively, and manage commitments and handoffs in line with the Last Planner System of Production Control.</p>"
          }
        },
        "faq_item_bAXDXk": {
          "type": "faq_item",
          "settings": {
            "question": "Can I create schedules directly in Asta Connect?",
            "answer": "<p>Yes. Teams can either import an existing master programme or create a new master schedule directly in Asta Connect.</p>"
          }
        },
        "faq_item_dnXGEP": {
          "type": "faq_item",
          "settings": {
            "question": "How does it help manage tasks day to day?",
            "answer": "<p>Teams can visualise all tasks in one place, assign teammates, set dependencies and deadlines, and keep to‑do lists organised so nothing falls between the cracks.</p>"
          }
        },
        "faq_item_rp4GXT": {
          "type": "faq_item",
          "settings": {
            "question": "Can Asta Connect help monitor performance?",
