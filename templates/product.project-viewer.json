    "parallel_two_column_accordion_xi4PpU": {
      "type": "parallel-two-column-accordion",
      "blocks": {
        "accordion_item_AX7zXQ": {
          "type": "accordion_item",
          "settings": {
            "title": "Contractors",
            "content_1": "<p>Read‑only access to project schedules so site teams, QS's, and managers can view details without risking changes.</p>",
            "content_2": "<p>Easy navigation of tasks, milestones, and filters so users can quickly find what affects their area of work.</p>",
            "content_3": "<p>Lightweight deployment that lets you roll out programme visibility widely, including to site cabins and partner organisations.</p>",
            "content_4": "",
            "content_5": "",
            "content_6": ""
          }
        },
        "accordion_item_htnMQm": {
          "type": "accordion_item",
          "settings": {
            "title": "Subcontractors",
            "content_1": "<p>Read‑only access to current programmes so site supervisors and planners can check dates and logic safely.</p>",
            "content_2": "<p>Quick views of relevant tasks, milestones, and float to plan crews and deliveries around real constraints.</p>",
            "content_3": "<p>Simple rollout to site teams and offices so everyone works from the same trusted schedule.</p>",
            "content_4": "",
            "content_5": "",
            "content_6": ""
          }
        },
        "accordion_item_EDULcY": {
          "type": "accordion_item",
          "settings": {
            "title": "Designers and Consultants",
            "content_1": "<p>Read‑only access to project schedules so teams can explore logic, dates, and critical paths safely.</p>",
            "content_2": "<p>Fast filtering and navigation to focus on specific workstreams, phases, or milestones.</p>",
            "content_3": "<p>Simple distribution to internal teams and clients so everyone reviews the same trusted programme view.</p>",
            "content_4": "",
            "content_5": "",
            "content_6": ""
          }
        },
        "accordion_item_83TNbE": {
          "type": "accordion_item",
          "settings": {
            "title": "Residential Construction",
            "content_1": "<p>Read‑only access to site and plot‑level programmes so teams can check build stages and handover dates safely.</p>",
            "content_2": "<p>Easy views of milestones such as releases, inspections, and completions to coordinate trades and customer commitments.</p>",
            "content_3": "<p>Simple rollout to site cabins, sales offices, and partners so everyone works from the same trusted schedule.</p>",
            "content_4": "",
            "content_5": "",
            "content_6": ""
          }
        },
        "accordion_item_fBMQnd": {
          "type": "accordion_item",
          "settings": {
            "title": "Clients and Asset Owners",
            "content_1": "<p>Read‑only access to project schedules so stakeholders can explore dates, milestones, and critical paths safely.</p>",
            "content_2": "<p>Simple, navigable views that make it easy to focus on key milestones, gateways, and handover points.</p>",
            "content_3": "<p>Easy distribution across client teams so everyone reviews the same trusted version of the programme.</p>",
            "content_4": "",
            "content_5": "",
            "content_6": ""
          }
        }
