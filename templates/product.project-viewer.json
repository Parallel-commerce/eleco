    "parallel_faq_accordion_3Vq7Fm": {
      "type": "parallel-faq-accordion",
      "blocks": {
        "faq_item_QVNkTB": {
          "type": "faq_item",
          "settings": {
            "question": "What is ProjectViewer?",
            "answer": "<p>ProjectViewer is a read only application that lets users open and explore project schedules without needing a full planning licence or risking accidental changes.</p>"
          }
        },
        "faq_item_bVkqMa": {
          "type": "faq_item",
          "settings": {
            "question": "Who is ProjectViewer for?",
            "answer": "<p>It is designed for site teams, commercial staff, management, clients, and partners who need clear visibility of programme dates, milestones, and logic but do not build the schedules themselves.</p>"
          }
        },
        "faq_item_r4jYJ9": {
          "type": "faq_item",
          "settings": {
            "question": "How does ProjectViewer help planners?",
            "answer": "<p>By letting others self serve schedule information, planners spend less time creating ad hoc exports and more time analysing and controlling the programme.</p>"
          }
        },
        "faq_item_jARANR": {
          "type": "faq_item",
          "settings": {
            "question": "Why would I use ProjectViewer instead of our planning tool?",
            "answer": "<p>ProjectViewer gives wider teams access to schedules in a simpler, safer interface, freeing planners from constant status requests and reducing the cost of full licences for occasional users.</p>"
          }
        },
        "faq_item_VkLqTr": {
          "type": "faq_item",
          "settings": {
            "question": "What can I do in ProjectViewer?",
            "answer": "<p>You can open project schedules, navigate tasks and milestones, apply filters and views, and review critical paths and dependencies, all in read only mode.</p>"
          }
        },
        "faq_item_nU7LXm": {
          "type": "faq_item",
          "settings": {
            "question": "Can I edit schedules in ProjectViewer?",
            "answer": "<p>You can open project schedules, navigate tasks and milestones, apply filters and views, and review critical paths and dependencies, all in read only mode.</p>"
          }
        },
        "faq_item_t6MLXe": {
          "type": "faq_item",
          "settings": {
            "question": "Does ProjectViewer support multiple projects?",
            "answer": "<p>Yes, you can open and review multiple project files, allowing portfolio teams and managers to check different programmes as needed.</p>"
          }
        },
        "faq_item_NVqVfU": {
          "type": "faq_item",
          "settings": {
            "question": "Which planning tools does ProjectViewer work with?",
            "answer": "<p>ProjectViewer is designed to work with schedules produced in your primary planning system (for example, Asta Powerproject), using the same file formats and structures.</p>"
          }
        },
        "faq_item_bFDdzT": {
          "type": "faq_item",
          "settings": {
            "question": "Do users need specialist training?",
            "answer": "<p>Most users can get started quickly because the interface focuses on viewing, searching, and filtering; short familiarisation sessions are usually sufficient.</p>"
          }
        },
        "faq_item_bAa3Kk": {
          "type": "faq_item",
          "settings": {
            "question": "Can ProjectViewer be used on site?",
            "answer": "<p>Yes, it can be deployed to site cabins and laptops so supervisors and foremen can check up to date programmes directly.</p>"
          }
        },
        "faq_item_iNTgLB": {
          "type": "faq_item",
          "settings": {
            "question": "How is ProjectViewer licensed?",
            "answer": "<p>Licensing is typically lighter and more cost effective than full planner licences, making it viable to roll out to a broad audience.</p>"
          }
        },
        "faq_item_bAXDXk": {
          "type": "faq_item",
          "settings": {
            "question": "What support is available for ProjectViewer?",
            "answer": "<p>Support usually covers installation, configuration, updates, and user assistance, helping your organisation deploy and adopt the tool successfully.</p>"
          }
        }
      },
      "block_order": [
        "faq_item_QVNkTB",
        "faq_item_bVkqMa",
