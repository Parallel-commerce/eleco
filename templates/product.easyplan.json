    "parallel_two_column_accordion_xi4PpU": {
      "type": "parallel-two-column-accordion",
      "blocks": {
        "accordion_item_AX7zXQ": {
          "type": "accordion_item",
          "settings": {
            "title": "Contractors",
            "content_1": "<p>Link and maintain fully resourced short term plans that align to the master schedule.</p>",
            "content_2": "<p>Create baselines to evidence the impact of late information, variations, and access issues.</p>",
            "content_3": "<p>Use visual logic views to show how resequencing affects milestones and handover dates.</p>",
            "content_4": "<p>Track resources and costs against plan to protect margin.</p>",
            "content_5": "<p>Produce clear delay and disruption records to support commercial positions.</p>",
            "content_6": ""
          }
        },
        "accordion_item_htnMQm": {
          "type": "accordion_item",
          "settings": {
            "title": "Subcontractors",
            "content_1": "<p>Break down main contractor programmes into clear, trade-specific work packages.</p>",
            "content_2": "<p>Maintain short-term lookahead schedules that stay aligned with the master schedule.</p>",
            "content_3": "<p>Quickly resequence activities as access, design, or predecessor trades change.</p>",
            "content_4": "<p>Track labour, plant, and productivity to keep packages on target.</p>",
            "content_5": "",
            "content_6": ""
          }
        },
        "accordion_item_EDULcY": {
          "type": "accordion_item",
          "settings": {
            "title": "Designers and Consultants",
            "content_1": "<p>Build integrated design, approval, and procurement programmes with clear dependencies.</p>",
            "content_2": "<p>Coordinate design deliverables with construction sequences.</p>",
            "content_3": "<p>Model “what-if” scenarios to advise clients on phasing, acceleration, and mitigation options.</p>",
            "content_4": "<p>Apply structured coding to analyse progress by discipline, package, or building zone.</p>",
            "content_5": "<p>Generate concise reports that support planning submissions and stakeholder reviews.</p>",
            "content_6": ""
          }
        },
        "accordion_item_aFFapF": {
          "type": "accordion_item",
          "settings": {
            "title": "Residential Construction",
            "content_1": "<p>Plan repeatable unit types, phases, and blocks using reusable templates.</p>",
            "content_2": "<p>Sequence trades efficiently across plots to maximise crew productivity.</p>",
            "content_3": "<p>Track starts, completions, and handovers by plot, block, and tenure.</p>",
            "content_4": "<p>Monitor key dates for inspections, client changes, and legal completions.</p>",
            "content_5": "<p>Report clearly on build progress, slippage, and forecast completions.</p>",
            "content_6": ""
          }
        },
        "accordion_item_tQ9Tta": {
          "type": "accordion_item",
          "settings": {
            "title": "Clients and Asset Owners",
            "content_1": "<p>View consistent programme structures across multiple projects and frameworks.</p>",
            "content_2": "<p>Compare baseline and current forecasts to spot emerging delays early.</p>",
            "content_3": "<p>Apply coding to analyse performance by region, contractor, or asset type.</p>",
            "content_4": "<p>Link milestones to strategic outcomes, budgets, and operational readiness.</p>",
            "content_5": "<p>Receive transparent reporting that supports governance, approvals, and investment decisions.</p>",
            "content_6": ""
          }
        }
      },
