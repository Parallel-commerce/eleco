    "parallel_faq_accordion_3Vq7Fm": {
      "type": "parallel-faq-accordion",
      "blocks": {
        "faq_item_QVNkTB": {
          "type": "faq_item",
          "settings": {
            "question": "Who is Asta Powerproject for?",
            "answer": "<p>Asta Powerproject is designed to scale. It’s used by large £1B enterprises as well as smaller independent contractors and it’s also widely adopted across industries beyond construction for effective project planning and management.</p>"
          }
        },
        "faq_item_bVkqMa": {
          "type": "faq_item",
          "settings": {
            "question": "What devices can I install Asta Powerproject on?",
            "answer": "<p>The software is available for download on Windows PC. There is a separately licensed companion app for use on iOS and Android.</p>"
          }
        },
        "faq_item_jARANR": {
          "type": "faq_item",
          "settings": {
            "question": "Can it be used on a Macbook?",
            "answer": "<p>Yes. By upgrading to Asta Powerproject SaaS, you can access it seamlessly on a Mac</p>"
          }
        },
        "faq_item_bAXDXk": {
          "type": "faq_item",
          "settings": {
            "question": "What is the difference between a single and a concurrent licence?",
            "answer": "<p>A single licence is tied to one user on one device. </p><p>A concurrent licence allows multiple users to share the same licence across different devices, offering greater flexibility and lowering the cost per user. </p><p>Both options suit businesses of any size, depending on your needs.</p>"
          }
        },
        "faq_item_iLkedR": {
          "type": "faq_item",
          "settings": {
            "question": "Why choose Asta Powerproject over other scheduling tools?",
            "answer": "<p>Asta Powerproject offers features unique to our user base, offering improved usability, more accurate scheduling and better analytics which are not available in other project management solutions. This helps you to predict, plan, and proactively avoid delays, giving greater certainty and smarter outcomes.</p><p>It is also consistently recognised for being user-friendly, efficient, and cost-effective.</p>"
          }
        },
        "faq_item_3zcwtw": {
          "type": "faq_item",
          "settings": {
            "question": "What language versions are available?",
            "answer": "<p>Asta Powerproject is available in English (Australia, UK, US versions), Danish, Dutch, Finnish, German, Norwegian, Swedish, French, Polish, Spanish, Italian and Turkish.</p><p>For other languages, please refer to our list of approved resellers.</p><p>We post all Asta Powerproject’s latest updates here.<br/><br/></p>"
          }
        },
        "faq_item_Y8h4bQ": {
          "type": "faq_item",
          "settings": {
            "question": "Can stakeholders view my project without a licence?",
            "answer": "<p>Yes. Stakeholders can download our free ProjectViewer to access your project without requiring a licence.</p>"
          }
        },
        "faq_item_mDbcdE": {
          "type": "faq_item",
          "settings": {
            "question": "Can a single licence be transferred to another colleague or device?",
            "answer": "<p>Yes. Users can follow the steps within the software to move a licence between a device. If you need to cancel a licence off a device for which you no longer have access, our support team can do this remotely; contact us at support@elecosoft.com.</p>"
          }
        },
        "faq_item_FbD6cb": {
          "type": "faq_item",
          "settings": {
            "question": "What support and training are available?",
            "answer": "<p>We provide comprehensive in-house training solutions for new users and more advanced sessions for experienced teams, ensuring everyone can get the most out of Asta Powerproject.</p>"
          }
        }
      },
      "block_order": [
        "faq_item_QVNkTB",
