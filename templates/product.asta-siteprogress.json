    "parallel_faq_accordion_3Vq7Fm": {
      "type": "parallel-faq-accordion",
      "blocks": {
        "faq_item_QVNkTB": {
          "type": "faq_item",
          "settings": {
            "question": "What is Asta Siteprogress and how does it work with Asta Powerproject?",
            "answer": "<p>Asta Siteprogress  is an app for recording progress on tasks and building stages from a remote location using a mobile device.​ At the start of a period, an administrator exports project information from Powerproject so that the relevant tasks and plots appear in the app for each user.​ At the end of the period, users submit their updates and an Asta Siteprogress Administrator imports and applies the approved changes back into the Powerproject plan.</p>"
          }
        },
        "faq_item_bVkqMa": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need an extra modules in Powerproject to use Siteprogress?",
            "answer": "<p>Siteprogress is an add‑on connected to Asta Powerproject, so you need a compatible Powerproject installation plus the Siteprogress functionality enabled.​ </p>"
          }
        },
        "faq_item_jARANR": {
          "type": "faq_item",
          "settings": {
            "question": "What devices and operating systems are supported?",
            "answer": "<p>Siteprogress is available as a mobile app for iOS and Android.</p>"
          }
        },
        "faq_item_bAXDXk": {
          "type": "faq_item",
          "settings": {
            "question": "Can I use Siteprogress offline and what happens to updates when I have no signal?",
            "answer": "<p>Once project data has been downloaded, you can record progress in Siteprogress even without a valid internet connection (for example, in remote or low‑signal areas). While offline, your changes (progress values, photos, notes) are stored locally on the device. When a connection becomes available, you submit your changes and the app synchronises them, making them available for import into the Powerproject programme.</p>"
          }
        },
        "faq_item_GHpatt": {
          "type": "faq_item",
          "settings": {
            "question": "How is Asta Siteprogress licenced?",
            "answer": "<p>You will need an Asta Powerproject licence, as well as an additional licence to use the app.</p>"
          }
        },
        "faq_item_dwXCEV": {
          "type": "faq_item",
          "settings": {
            "question": "Is Siteprogress included with my existing Asta Powerproject licences?",
            "answer": "<p>Siteprogress requires an additional licence.</p>"
          }
        },
        "faq_item_iN34Cy": {
          "type": "faq_item",
          "settings": {
            "question": "What support is available for Siteprogress?",
            "answer": "<p>Siteprogress has user guides available and video tutorials to help users learn the workflow.</p>"
          }
        }
