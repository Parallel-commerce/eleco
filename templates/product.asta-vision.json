    "parallel_two_column_accordion_xi4PpU": {
      "type": "parallel-two-column-accordion",
      "blocks": {
        "accordion_item_AX7zXQ": {
          "type": "accordion_item",
          "settings": {
            "title": "Contractors",
            "content_1": "<p>Real-time portfolio visibility through centralised schedule management</p>",
            "content_2": "<p>Reduce time-related project costs by identifying issues before they escalate</p>",
            "content_3": "<p>Supports good practice by automatically logging changes against each revision.</p>",
            "content_4": "<p>Develop contract-specific workflows flexibly, standardising enture project approach.</p>",
            "content_5": "",
            "content_6": ""
          }
        },
        "accordion_item_htnMQm": {
          "type": "accordion_item",
          "settings": {
            "title": "Sub contractors",
            "content_1": "<p>Real-time multi-user collaboration means everyone is working from the same project plans.</p>",
            "content_2": "<p>Access tender planning tools allowing for accurate and reliable bids for a competitive advantage.</p>",
            "content_3": "<p>Controlled access and clear responsibilities fosters accountability while protecting sensitive information.</p>",
            "content_4": "<p><a href=\"/products/asta-siteprogress\" title=\"Asta SiteProgress\">Asta Siteprogress</a> integration allows for on-site updates that feed information directly into Asta Vision.</p>",
            "content_5": "",
            "content_6": ""
          }
        },
        "accordion_item_EDULcY": {
          "type": "accordion_item",
          "settings": {
            "title": "Designers and consultancy",
            "content_1": "<p>Centralised programme hub to align design stages, approvals, and delivery milestones across all projects.</p>",
            "content_2": "<p>Configurable, portfolio‑level views and dashboards to support client reporting and governance.</p>",
            "content_3": "<p>Controlled collaboration spaces so internal teams and external partners can work on shared, live schedules.</p>",
            "content_4": "",
            "content_5": "",
            "content_6": ""
          }
        },
        "accordion_item_XX8GYV": {
          "type": "accordion_item",
          "settings": {
            "title": "Residential construction",
            "content_1": "<p>Portfolio-level oversight for multiple housing developments enables faster, strategic decision-making.</p>",
            "content_2": "<p>Template-driven planning to standardise planning and minimise the risk of errors.</p>",
            "content_3": "<p>Seamless resource management across multiple developments to co-ordinate trades.</p>",
            "content_4": "<p>Controlled access features allow different users to co-ordinate, for better supply chain management.</p>",
            "content_5": "",
            "content_6": ""
          }
        },
        "accordion_item_MXN6jV": {
          "type": "accordion_item",
          "settings": {
            "title": "Clients and Asset owners",
            "content_1": "<p>Portfolio hub giving a single, controlled view of all project schedules and key milestones.</p>",
            "content_2": "<p>Standardised coding, templates, and approvals so partners supply data in a consistent, comparable format.</p>",
            "content_3": "<p>Configurable views and reports to support governance forums, gateway decisions, and board reporting.</p>",
            "content_4": "",
            "content_5": "",
            "content_6": ""
          }
        }
      },
      "block_order": [
