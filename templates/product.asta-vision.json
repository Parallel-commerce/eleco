    "parallel_faq_accordion_3Vq7Fm": {
      "type": "parallel-faq-accordion",
      "blocks": {
        "faq_item_bVkqMa": {
          "type": "faq_item",
          "settings": {
            "question": "What is Asta Vision?",
            "answer": "<p>Asta Vision is the cloud intelligence layer for Asta Powerproject. It centralises programme data, making schedules accessible, visible, and usable across your organisation through business intelligence, quality controls, and collaboration tools.</p>"
          }
        },
        "faq_item_HE6Npx": {
          "type": "faq_item",
          "settings": {
            "question": "Who is Asta Vision for?",
            "answer": "<p>Asta Vision is used by planners, project managers, PMOs, commercial teams, directors, and clients. Anyone who needs reliable insight into programme data can access it without needing to use Powerproject.</p>"
          }
        },
        "faq_item_QkUV3x": {
          "type": "faq_item",
          "settings": {
            "question": "What benefits does Asta Vision offer enterprise companies?",
            "answer": "<p>Asta Vision helps organisations move beyond individual schedule files by:</p><ul><li>Making programme data accessible to the wider business</li><li>Applying consistent quality and standardisation checks</li><li>Supporting governance, assurance, and review processes</li><li>Enabling collaboration without distributing .pp files</li><li>Providing trusted data for business intelligence and reporting tools<br/><br/></li></ul>"
          }
        },
        "faq_item_XjQ7tP": {
          "type": "faq_item",
          "settings": {
            "question": "Is my data secure in Asta Vision?",
            "answer": "<p>Yes. Asta Vision is hosted on Microsoft Azure and uses enterprise-grade security, role-based access control, and auditing to protect your data and ensure the right people see the right information.</p>"
          }
        },
        "faq_item_jARANR": {
          "type": "faq_item",
          "settings": {
            "question": "How is Asta Vision different from Asta Powerproject?",
            "answer": "<p>Asta Powerproject is where schedules are built and maintained.</p><p>Asta Vision sits above it, providing structured access to business intelligence data, schedule quality and standardisation tools, and shared views for teams who need insight without editing the programme.</p>"
          }
        },
        "faq_item_bAXDXk": {
          "type": "faq_item",
          "settings": {
            "question": "Do I still need Asta Powerproject if I use Asta Vision?",
            "answer": "<p>Yes. Asta Vision extends Powerproject rather than replacing it. All planning and schedule changes remain in Powerproject, while Vision provides oversight, governance, and data access at scale.</p>"
          }
        },
        "faq_item_NBDry8": {
          "type": "faq_item",
          "settings": {
            "question": "How does Asta Vision get data from my schedules?",
            "answer": "<p>For the best results, Asta Vision creates projects for you and sets them up in line with your agreed planning and data standards. Existing and historic Powerproject schedules can also be uploaded and then managed within Vision going forward.</p>"
          }
        },
        "faq_item_H9HznX": {
          "type": "faq_item",
          "settings": {
            "question": "Can Asta Vision change my schedule?",
            "answer": "<p>No. Asta Vision is not used to edit schedules. All programme logic and updates remain fully controlled within Asta Powerproject.</p>"
          }
        },
        "faq_item_w9Dmy3": {
          "type": "faq_item",
          "settings": {
            "question": "Can I use my own reporting tools with Asta Vision?",
            "answer": "<p>Yes. Asta Vision exposes structured programme data through a SQL BI database, allowing you to build dashboards and reports in tools such as Power BI or Tableau.</p>"
          }
        }
      },
