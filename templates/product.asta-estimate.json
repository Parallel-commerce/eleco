    "parallel_faq_accordion_3Vq7Fm": {
      "type": "parallel-faq-accordion",
      "blocks": {
        "faq_item_QVNkTB": {
          "type": "faq_item",
          "settings": {
            "question": "Who is Asta Estimate for?",
            "answer": "<p>Asta Estimate is designed for estimators, QSs, planners and project teams who need accurate, structured estimates that link cost, time and carbon in one place.</p><p>It is designed to provide consistent, auditable estimating rather than ad‑hoc spreadsheets.<br/><br/></p>"
          }
        },
        "faq_item_bVkqMa": {
          "type": "faq_item",
          "settings": {
            "question": "Is Asta Estimate suitable for smaller contractors and subcontractors?",
            "answer": "<p>Yes, Asta Estimate works well for smaller organisations that need professional-grade estimating without the overhead of complex enterprise systems. It supports repetitive tenders, trade-level breakdowns and standard templates so teams can price quickly and present estimates clearly to main contractors and clients.</p>"
          }
        },
        "faq_item_Ud6FWL": {
          "type": "faq_item",
          "settings": {
            "question": "How does Asta Estimate work with Asta Powerproject?",
            "answer": "<p>Asta Estimate connects directly with Asta Powerproject so that cost and time share the same underlying data. This allows teams to align estimates with programmes, use model-based quantities in both tools, and maintain a single thread of information from tender through delivery.​</p>"
          }
        },
        "faq_item_jARANR": {
          "type": "faq_item",
          "settings": {
            "question": "Where does the cost database come from?",
            "answer": "<p>Asta Estimate includes structured cost libraries that draw on recognised data sources including the RICS NRM1 and NRM2, which is widely used across the civil and construction sectors. These libraries can be customised with company norms, regional pricing and project-specific rates so that each organisation can refine the baseline data to its own standards.</p>"
          }
        },
        "faq_item_bAXDXk": {
          "type": "faq_item",
          "settings": {
            "question": "Can the cost database be customised?",
            "answer": "<p>Yes, users can adapt and extend the cost database, adding or editing items, assemblies and labour rates to match their own methods and supply chain. This helps teams maintain consistency across bids while still reflecting real-world pricing and productivity.<br/><br/></p>"
          }
        },
        "faq_item_DQVGf9": {
          "type": "faq_item",
          "settings": {
            "question": "Does Asta Estimate integrate with other systems?",
            "answer": "<p>Yes, Asta Estimate is designed to work within a broader digital ecosystem, including BIM tools, Bluebeam-based take-off workflows, ERP and analytics platforms.</p><p>This reduces double entry, improves reporting and helps different teams work from one consistent dataset.</p>"
          }
        },
        "faq_item_ebJJeq": {
          "type": "faq_item",
          "settings": {
            "question": "How does Asta Estimate handle carbon?",
            "answer": "<p>Asta Estimate includes carbon calculation and reporting tools, allowing users to link climate data and EPDs to cost plans through a dedicated Climate Module. Carbon data is taken from the ICE database. This gives early visibility of carbon impact alongside cost, supporting compliance, client reporting and more sustainable decision-making.</p>"
          }
        },
        "faq_item_g4eBDE": {
          "type": "faq_item",
          "settings": {
            "question": "Can Asta Estimate be used on a MacBook?",
            "answer": "<p>Asta Estimate is Windows-based, but Mac users can typically run it by using Windows via a virtual machine or remote desktop solution. This approach is similar to how other Windows-only construction applications are used in mixed IT environments.</p>"
          }
        },
        "faq_item_xMEVnw": {
          "type": "faq_item",
          "settings": {
            "question": "Can a licence be transferred to another colleague or device?",
            "answer": "<p>Licences can normally be reassigned if team members change roles or devices are upgraded, following your organisation’s licence management process. Your account manager or support contact can advise on the practical steps to move licences between users or machines. You can contact us at support@elecosoft.com.</p>"
          }
        },
        "faq_item_acXeiH": {
          "type": "faq_item",
          "settings": {
            "question": "What support and training are available?",
            "answer": "<p>We provide comprehensive in-house training solutions for new users, ensuring everyone can get the most out of Asta Estimate.</p>"
          }
        }
      },
