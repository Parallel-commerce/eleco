    "parallel_two_column_accordion_xi4PpU": {
      "type": "parallel-two-column-accordion",
      "blocks": {
        "accordion_item_AX7zXQ": {
          "type": "accordion_item",
          "settings": {
            "title": "Contractors",
            "content_1": "<p>Improve bid accuracy and consistency with structured, up-to-date cost databases instead of spreadsheets, reducing the risk of underpricing or missed items on projects.​</p>",
            "content_2": "<p>Link estimates directly with schedules and BIM to see cost, time and carbon impacts together, helping contractors manage change, protect margin and evidence decisions to Tier 1 clients and funders.</p>",
            "content_3": "",
            "content_4": "",
            "content_5": "",
            "content_6": ""
          }
        },
        "accordion_item_htnMQm": {
          "type": "accordion_item",
          "settings": {
            "title": "Subcontractors",
            "content_1": "<p>Enable repeatable, fast estimating for frequent tenders, with reusable templates and libraries that suit specialist trades such as steel, concrete and MEP.​</p>",
            "content_2": "<p>Provide clear, structured breakdowns of cost, time and carbon that make it easier to respond to multiple main contractors on the same project while demonstrating professionalism and transparency.</p>",
            "content_3": "",
            "content_4": "",
            "content_5": "",
            "content_6": ""
          }
        },
        "accordion_item_EDULcY": {
          "type": "accordion_item",
          "settings": {
            "title": "Designers and Consultants",
            "content_1": "<p>Model-based quantity take-offs and linked cost plans, creating a robust basis for early-stage option studies and value engineering.​</p>",
            "content_2": "<p>Transparent carbon and cost metrics that help advisors test scenarios, support planning submissions and meet emerging sustainability and reporting standards.</p>",
            "content_3": "",
            "content_4": "",
            "content_5": "",
            "content_6": ""
          }
        },
        "accordion_item_TaQTDx": {
          "type": "accordion_item",
          "settings": {
            "title": "Residential Construction",
            "content_1": "<p>A consistent way to price standard house types, phases and options using reusable cost structures and assemblies.​</p>",
            "content_2": "<p>Produce detailed cost and carbon breakdowns that support internal approvals, sales pricing, and compliance requirements such as those linked to the Building Safety Act.</p>",
            "content_3": "",
            "content_4": "",
            "content_5": "",
            "content_6": ""
          }
        },
        "accordion_item_UPkC8E": {
          "type": "accordion_item",
          "settings": {
            "title": "Clients and Asset Owners",
            "content_1": "<p>Standardised reports that show cost, time and carbon in a format that is easy to review across multiple projects and suppliers.​</p>",
            "content_2": "<p>Enable better decision-making by making the impact of design changes and phasing visible early, supporting more reliable budgets, programmes and sustainability targets over the asset lifecycle.</p>",
            "content_3": "",
            "content_4": "",
            "content_5": "",
            "content_6": ""
          }
        }
      },
      "block_order": [
        "accordion_item_AX7zXQ",
