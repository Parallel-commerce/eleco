    "parallel_faq_accordion_3Vq7Fm": {
      "type": "parallel-faq-accordion",
      "blocks": {
        "faq_item_QVNkTB": {
          "type": "faq_item",
          "settings": {
            "question": "What is Asta 4D?",
            "answer": "<p>Asta 4D is the 4D (time-linked) planning and visualisation capability for Asta Powerproject, connecting the project schedule to BIM models to show how a project will be built over time. It turns 3D models into animated construction sequences, improving communication, coordination, and issue identification across the project team.</p>"
          }
        },
        "faq_item_bVkqMa": {
          "type": "faq_item",
          "settings": {
            "question": "What is model-based planning?",
            "answer": "<p>Model-based planning links the construction programme directly to a digital model, so time, sequence, and geometry are managed together rather than in separate tools. This allows teams to simulate the build, test options, and spot problems visually before they affect cost, safety, or time on site.</p>"
          }
        },
        "faq_item_jARANR": {
          "type": "faq_item",
          "settings": {
            "question": "Who is Asta 4D for?",
            "answer": "<p>Asta 4D is designed for contractors, subcontractors, designers, consultants, clients, and asset owners who want to plan and review projects using 4D rather than Gantt charts alone. It suits organisations delivering complex buildings, infrastructure, or residential schemes where visualising sequence, logistics, and risk is critical.</p>"
          }
        },
        "faq_item_xbqw6y": {
          "type": "faq_item",
          "settings": {
            "question": "How does Asta 4D work with Asta Powerproject?",
            "answer": "<p>Asta 4D is integrated with Asta Powerproject so the construction schedule drives the 4D simulation directly, using tasks, calendars, and logic already in the programme. BIM models (for example from IFC) are linked to tasks, and the 4D viewer—built on Unity—plays the construction sequence, updated automatically when the schedule or model changes.</p>"
          }
        },
        "faq_item_D6kYMK": {
          "type": "faq_item",
          "settings": {
            "question": "Does Asta 4D export to other formats?",
            "answer": "<p>Yes, AVI movie files along with JPEG, PNG, GIF, BMP, TIFF imagery formats.</p>"
          }
        },
        "faq_item_J98dPj": {
          "type": "faq_item",
          "settings": {
            "question": "What BIM Model formats does Asta 4D use?",
            "answer": "<p>Asta can import one or multiple IFC files, which can then be overlaid to create a federated model view.</p>"
          }
        },
        "faq_item_WMUxVH": {
          "type": "faq_item",
          "settings": {
            "question": "Can Temporary Works be visualised in Asta 4D?",
            "answer": "<p>Yes. Separate IFC files for site objects, like cranes and site offices, can be imported and moved around within the 3D viewer. These can be linked to activities to control appearance, and have movement paths added to animate them.</p>"
          }
        },
        "faq_item_rTRq3B": {
          "type": "faq_item",
          "settings": {
            "question": "Do you offer training for 4D?",
            "answer": "<p>Yes, we offer a two-day Introduction to Asta 4D course.</p>"
          }
        },
        "faq_item_bAXDXk": {
          "type": "faq_item",
          "settings": {
            "question": "Can stakeholders see my project if they don't have a license?",
            "answer": "<p>If a stakeholder hasn't bought a licence but needs to view the project, they can download our Project Viewer.</p>"
          }
        }
      },
