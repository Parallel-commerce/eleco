    "parallel_faq_accordion_3Vq7Fm": {
      "type": "parallel-faq-accordion",
      "blocks": {
        "faq_item_QVNkTB": {
          "type": "faq_item",
          "settings": {
            "question": "What is the difference between the trial and paid version?",
            "answer": "<p>The free trial gives you full access to every feature in the software for 14 days. No credit card is required, no locked features.</p>"
          }
        },
        "faq_item_iLkedR": {
          "type": "faq_item",
          "settings": {
            "question": "How do I access the software once I purchase?",
            "answer": "<p>Our digital software allows for you to access the software instantly. You will receive an email walking you through the steps; and where to find your licence and activation key. You can be up and running within just a few minutes. </p>"
          }
        },
        "faq_item_d8Pe8E": {
          "type": "faq_item",
          "settings": {
            "question": "What is included in the enhanced support upgrade?",
            "answer": "<p>Find comfort knowing you will be looked after every step of the way. </p><p>You will receive access to our trained product specialists including technical, installation and activation support in needed. </p><p>We constantly tailor our approach to support you and your business with a 99% ticket resolution within 6 hours.</p>"
          }
        },
        "faq_item_FbD6cb": {
          "type": "faq_item",
          "settings": {
            "question": "How do I cancel my subscription?",
            "answer": "<p>If you are looking to cancel your annual subscription you will need to provide a written notice of termination at least 60 days prior to the renewal date. </p><p>If you cancel in accordance with this notice period, your access will continue until the end of your current term. </p>"
          }
        },
        "faq_item_bAXDXk": {
          "type": "faq_item",
          "settings": {
            "question": "What is the difference between a single and a concurrent licence?",
            "answer": "<p>A single licence is tied to one user on one device. </p><p>A concurrent licence allows multiple users to share the same licence across different devices, offering greater flexibility and lowering the cost per user. </p><p>Both options suit businesses of any size, depending on your needs.</p>"
          }
        },
        "faq_item_mDbcdE": {
          "type": "faq_item",
          "settings": {
            "question": "Can a single licence be transferred to another colleague or device?",
            "answer": "<p>Yes. Users can follow the steps within the software to move a licence between a device. If you need to cancel a licence off a device for which you no longer have access, our support team can do this remotely; contact us at support@elecosoft.com.</p>"
          }
        },
        "faq_item_bVkqMa": {
          "type": "faq_item",
          "settings": {
            "question": "What devices can I install Asta Powerproject on?",
            "answer": "<p>The software is available for download on Windows PC. There is a separately licenced companion app for use on iOS and Android.</p>"
          }
        },
        "faq_item_jARANR": {
          "type": "faq_item",
          "settings": {
            "question": "Can it be used on a Macbook?",
            "answer": "<p>Yes. By upgrading to Asta Powerproject SaaS subscription, you can access it seamlessly on a Mac. You can contact us at support@elecosoft.com.</p>"
          }
        },
        "faq_item_3zcwtw": {
          "type": "faq_item",
          "settings": {
            "question": "What size and types of projects work best with Asta Powerproject?",
            "answer": "<p>Asta Powerproject suits everything from small works (extensions, fit‑outs, minor civils) to major megaprojects (landmark buildings, airports, highways), and scales from small contractors to large enterprises.</p><p>It works best on construction, infrastructure, and industrial projects that need logic‑driven CPM schedules, clear critical path and float analysis, and professional, phase‑by‑phase bar chart presentations for clients, planners, and dispute resolution.</p>"
          }
        },
        "faq_item_Y8h4bQ": {
          "type": "faq_item",
          "settings": {
            "question": "Can stakeholders view my project without a licence?",
            "answer": "<p>Yes. Stakeholders can download our free ProjectViewer to access your project without requiring a licence.</p>"
          }
        }
      },
