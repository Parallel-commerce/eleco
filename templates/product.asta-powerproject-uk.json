    "parallel_two_column_accordion_xi4PpU": {
      "type": "parallel-two-column-accordion",
      "blocks": {
        "accordion_item_AX7zXQ": {
          "type": "accordion_item",
          "settings": {
            "title": "Contractors",
            "content_1": "<p>Powerful critical path analysis and precise scheduling.</p>",
            "content_2": "<p>Comprehensive resource and cost management, early identification of budget issues.</p>",
            "content_3": "<p>Detailed history of project changes to support claims and resolve disputes.</p>",
            "content_4": "<p>Produce high-quality outputs for tender submissions to help win work with professional schedules.</p>",
            "content_5": "",
            "content_6": ""
          }
        },
        "accordion_item_htnMQm": {
          "type": "accordion_item",
          "settings": {
            "title": "Subcontractors",
            "content_1": "",
            "content_2": "<p>Simple functionality allows subcontractors to engaging directly with project data.</p>",
            "content_3": "<p>Clear task visibility and filters allow for visual clarity across complete programme of works.</p>",
            "content_4": "<p>Mobile progress tracking with Asta Siteprogress allows for on-site updates.</p>",
            "content_5": "<p>Free <a href=\"/products/project-viewer\" title=\"Project Viewer\">project viewer</a> for seamless communication, relevant to each project</p>",
            "content_6": ""
          }
        },
        "accordion_item_EDULcY": {
          "type": "accordion_item",
          "settings": {
            "title": "Designers and Consultants",
            "content_1": "<p><a href=\"/products/asta-powerproject-4d\" title=\"Asta Powerproject 4D\">BIM integration</a> and 4D planning enables consultants to combine 3D models with scheduling in one solution.</p>",
            "content_2": "<p>Built-in scenario analysis and risk management tools to explore optimal project outcomes.</p>",
            "content_3": "<p>Schedule Quality Checks against plans to ensure compliance with industry or company standards.</p>",
            "content_4": "<p>Customisable reports for clear communication and collaboration with clients, contractors and stakeholders.</p>",
            "content_5": "",
            "content_6": ""
          }
        },
        "accordion_item_M7z9KA": {
          "type": "accordion_item",
          "settings": {
            "title": "Residential Construction",
            "content_1": "<p>Repeated tasks and plot management for effective planning and procurement.</p>",
            "content_2": "<p>Line of balance for multi-plot developments, creating a smooth workflow between trades.</p>",
            "content_3": "<p>Template-based planning allows for consistency across planning and scheduling.</p>",
            "content_4": "<p><a href=\"/products/asta-siteprogress\" title=\"Asta SiteProgress\">Asta Siteprogress</a> mobile allows for photo uploads on-site creating an immediate picture of progress.</p>",
            "content_5": "",
            "content_6": ""
          }
        },
        "accordion_item_VxNne6": {
          "type": "accordion_item",
          "settings": {
            "title": "Clients and Asset Owners",
            "content_1": "<p>Real-time visibility across entire portfolios with <a href=\"/products/business-intelligence\" title=\"Business Intelligence\">BI integration</a> for strategic reporting.</p>",
            "content_2": "<p>Progress tracking against baselines means clients receive transparent reporting, with a full audit trail.</p>",
            "content_3": "<p>Evidence-based change management and impact documentation increases accountability.</p>",
            "content_4": "<p>Rock-solid records of progress provide robust evidence for any dispute resolution.</p>",
            "content_5": "",
            "content_6": ""
          }
        }
      },
      "block_order": [
        "accordion_item_AX7zXQ",
        "accordion_item_htnMQm",
        "accordion_item_EDULcY",
        "accordion_item_M7z9KA",
        "accordion_item_VxNne6"
      ],
      "disabled": true,
