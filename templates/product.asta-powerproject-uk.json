      "settings": {
        "heading": "Better project outcomes for every team",
        "heading_size": "h1",
        "anchor_id": "#capabilities",
        "padding_top": 72,
        "padding_bottom": 60
      }
    },
    "parallel_testimonials_6ayBHg": {
      "type": "parallel-testimonials",
      "blocks": {
        "testimonial_J3UM8L": {
          "type": "testimonial",
          "name": "Testimonial - Amy",
          "settings": {
            "name": "Amy Griffiths",
            "title": "Project Manager | Kier Group",
            "country_flag": "",
            "testimonial_text": "\"At every point we were being adaptive, reacting to changes and opportunities. Asta Powerproject allowed us to ask ... and have subscontractors feed into the discussion. As a result, we maintained our critical path and smooth workflow between trades.\""
