      "label": "Product name color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "nav_link_color",
      "label": "Navigation link color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "nav_link_hover_color",
      "label": "Navigation link hover color",
      "default": "#E75742"
    },
    {
      "type": "color",
      "id": "nav_link_hover_background",
      "label": "Navigation link hover background",
      "default": "transparent",
      "info": "Leave as transparent for no background"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background color",
      "default": "#E75742"
    },
    {
      "type": "color",
      "id": "button_background_hover_color",
      "label": "Button background hover color",
      "default": "#d04a35"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
