  "presets": [
    {
      "name": "Sticky Navigation",
      "blocks": [
        {
          "type": "nav_link",
          "settings": {
            "link_name": "Capabilities",
            "anchor": "capabilities"
          }
        },
        {
          "type": "nav_link",
          "settings": {
            "link_name": "Reviews",
            "anchor": "reviews"
          }
        },
        {
          "type": "nav_link",
          "settings": {
