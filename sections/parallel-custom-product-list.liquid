{{ 'component-card.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }


  .custom-product-list-{{ section.id }}__header {
    text-align: {{ section.settings.heading_alignment }};
    margin-bottom: 3rem;
  }

  .custom-product-list-{{ section.id }}__heading {
    margin: 0;
  }

  .custom-product-list-{{ section.id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    gap: 1.5rem;
  }

  @media screen and (min-width: 750px) {
    .custom-product-list-{{ section.id }}__grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    }
  }

  .custom-product-list-{{ section.id }}__card {
    background: #fff;
    border-radius: 14px;
    border: 1px solid rgba(var(--color-foreground), 0.09);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04), 0 4px 16px rgba(0, 0, 0, 0.06);
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    height: 100%;
    box-sizing: border-box;
  }

  .custom-product-list-{{ section.id }}__card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.06), 0 12px 28px rgba(0, 0, 0, 0.1);
  }

  .custom-product-list-{{ section.id }}__title-wrapper {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.07);
    margin-bottom: 1.5rem;
    min-height: 36px;
  }

  .custom-product-list-{{ section.id }}__icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .custom-product-list-{{ section.id }}__icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .custom-product-list-{{ section.id }}__title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    color: rgb(var(--color-foreground));
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .custom-product-list-{{ section.id }}__logo {
    display: flex;
    align-items: center;
    height: 24px;
  }

  .custom-product-list-{{ section.id }}__logo img {
    height: 24px;
    width: auto;
    max-width: 160px;
    display: block;
    object-fit: contain;
  }

  .custom-product-list-{{ section.id }}__description {
    color: rgba(var(--color-foreground), 0.6);
    line-height: 1.7;
    flex-grow: 1;
    margin: 0 0 2rem;
    font-size: 0.9375rem;
  }

  .custom-product-list-{{ section.id }}__description p {
    margin: 0;
  }

  .custom-product-list-{{ section.id }}__cta {
    margin-top: auto;
    align-self: flex-start;
  }
{%- endstyle -%}

<div
  {% if section.settings.anchor_id != blank and section.settings.anchor_id != '#' %}
    {%- assign clean_anchor_id = section.settings.anchor_id | replace: '#', '' -%}
    id="{{ clean_anchor_id }}"
  {% endif %}
  class="color-{{ section.settings.color_scheme }} gradient custom-product-list-{{ section.id }}"
>
  <div class="page-width section-{{ section.id }}-padding isolate">
    {% if section.settings.heading != blank %}
      <div class="custom-product-list-{{ section.id }}__header">
        <h2 class="custom-product-list-{{ section.id }}__heading {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="custom-product-list-{{ section.id }}__grid">
        {% for block in section.blocks %}
          {% assign product = block.settings.product %}
          {% if product != blank %}
            <div class="custom-product-list-{{ section.id }}__card" {{ block.shopify_attributes }}>
              <div class="custom-product-list-{{ section.id }}__title-wrapper">
                {%- if product.metafields.custom.product_logo != blank -%}
                  <div class="custom-product-list-{{ section.id }}__logo">
                    {{
                      product.metafields.custom.product_logo
                      | image_url: width: 320
                      | image_tag: loading: 'lazy', alt: product.title
                    }}
                  </div>
                {%- else -%}
                  <div class="custom-product-list-{{ section.id }}__icon">
                    {{ 'icon-asta-favicon.svg' | inline_asset_content }}
                  </div>
                  <h3 class="custom-product-list-{{ section.id }}__title">
                    {{ product.title }}
                  </h3>
                {%- endif -%}
              </div>

              {% if product.metafields.custom.short_description != blank %}
                <div class="custom-product-list-{{ section.id }}__description rte">
                  {{ product.metafields.custom.short_description | metafield_tag }}
                </div>
              {% endif %}

              <div class="custom-product-list-{{ section.id }}__cta">
                <a href="{{ product.url }}" class="button button--secondary">
                  {{ section.settings.button_text | default: 'Learn more' }}
                </a>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "|| Custom Product List",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Related Products",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "label": "Heading alignment"
    },
    {
      "type": "text",
      "id": "button_text",
      "default": "Learn more",
      "label": "Button text"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "Number of columns on desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "1",
      "label": "Number of columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section anchor"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Enter an ID for anchor links (e.g., 'features'). Links can use #features to jump to this section. Do not include the # symbol."
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product List",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}
