          "id": "column_2_type",
          "label": "Column 2 value type",
          "options": [
            {
              "value": "text",
              "label": "Text"
            },
            {
              "value": "tick",
              "label": "Tick (Yes)"
            },
            {
              "value": "cross",
              "label": "Cross (No)"
            }
          ],
