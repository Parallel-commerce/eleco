          "type": "header",
          "content": "Column 3"
        },
        {
          "type": "select",
          "id": "column_3_type",
          "label": "Column 3 value type",
          "options": [
            {
              "value": "text",
              "label": "Text"
            },
            {
              "value": "tick",
              "label": "Tick (Yes)"
            },
            {
              "value": "cross",
              "label": "Cross (No)"
            }
          ],
          "default": "text"
        },
        {
          "type": "text",
          "id": "column_3_text",
          "label": "Column 3 text",
          "default": "Value",
          "info": "Only used when value type is 'Text'"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison Table",
      "blocks": [
        {
          "type": "comparison_row",
          "settings": {
            "functionality_text": "Task of work per file",
            "column_2_type": "text",
            "column_2_text": "250",
            "column_3_type": "text",
            "column_3_text": "Unlimited"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "functionality_text": "Task per line of work",
            "column_2_type": "text",
            "column_2_text": "10",
            "column_3_type": "text",
            "column_3_text": "Unlimited"
