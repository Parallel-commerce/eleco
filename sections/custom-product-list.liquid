{{ 'component-card.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }


  .custom-product-list-{{ section.id }}__header {
    text-align: {{ section.settings.heading_alignment }};
    margin-bottom: 3rem;
  }

  .custom-product-list-{{ section.id }}__heading {
    margin: 0;
  }

  .custom-product-list-{{ section.id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    gap: 2rem;
  }

  @media screen and (min-width: 750px) {
    .custom-product-list-{{ section.id }}__grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    }
  }

  .custom-product-list-{{ section.id }}__card {
    background: #FFF;
    border-radius: 0.8rem;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
    height: 100%;
  }

  .custom-product-list-{{ section.id }}__card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    transform: translateY(-2px);
  }

  .custom-product-list-{{ section.id }}__title {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
    color: rgb(var(--color-foreground));
  }

  .custom-product-list-{{ section.id }}__description {
    color: rgba(var(--color-foreground), 0.7);
    line-height: 1.6;
    flex-grow: 1;
    margin: 0;
  }

  .custom-product-list-{{ section.id }}__button {
    margin-top: auto;
    padding: 0.75rem 1.5rem;
    border: 1px solid rgba(var(--color-foreground), 0.2);
    background: transparent;
    color: rgb(var(--color-foreground));
    text-decoration: none;
    border-radius: 0.4rem;
    display: inline-block;
    text-align: center;
    transition: all 0.3s ease;
    font-weight: 500;
  }

  .custom-product-list-{{ section.id }}__button:hover {
    border-color: rgb(var(--color-foreground));
    background: rgba(var(--color-foreground), 0.05);
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient custom-product-list-{{ section.id }}">
  <div class="page-width section-{{ section.id }}-padding isolate">
    {% if section.settings.heading != blank %}
      <div class="custom-product-list-{{ section.id }}__header">
        <h2 class="custom-product-list-{{ section.id }}__heading {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="custom-product-list-{{ section.id }}__grid">
        {% for block in section.blocks %}
          {% assign product = block.settings.product %}
          {% if product != blank %}
            <div class="custom-product-list-{{ section.id }}__card" {{ block.shopify_attributes }}>
              <h3 class="custom-product-list-{{ section.id }}__title">
                {{ product.title }}
              </h3>

              {% if product.metafields.custom.short_description != blank %}
                <p class="custom-product-list-{{ section.id }}__description">
                  {{ product.metafields.custom.short_description }}
                </p>
              {% endif %}

              <a href="{{ product.url }}" class="custom-product-list-{{ section.id }}__button">
                {{ section.settings.button_text | default: 'Learn more' }}
              </a>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Custom Product List",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Related Products",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "label": "Heading alignment"
    },
    {
      "type": "text",
      "id": "button_text",
      "default": "Learn more",
      "label": "Button text"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "Number of columns on desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "1",
      "label": "Number of columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product List",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}
